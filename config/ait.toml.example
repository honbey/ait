[server]
host = "127.0.0.1"
port = 8000
# 健康检查是否返回详细信息（版本、运行时间等）
health_detail = false
# 内存缓存（api_key / model / provider / ssrf_dns）过期条目清理间隔（秒）
cache_cleanup_interval_secs = 300
# 内存缓存条数上限：对全部缓存（api_key / model / provider / ssrf_dns）
# 是软阈值（条目超 90% 时 TTL 减半加速淘汰）；
# 对 model 缓存同时是硬上限（model 名来自请求体、攻击者可控，超出后不再缓存新条目，
# 防止恶意模型名导致缓存无限制增长）
cache_max_entries = 1000
# Ctrl-C 后等待 in-flight 请求完成的最大时间（秒），超时后强制退出
graceful_timeout_secs = 10
# 允许设置 X-Forwarded-For 的可信代理，空数组则不信任任何 XFF
# 每项可以是 IP 地址，也可以是 CIDR 网段，例如 "10.0.0.0/8"
trusted_proxies = ["127.0.0.1", "::1"]
# X-Forwarded-For 链中位于 Ait 前面的可信代理层数。
# 客户端 IP 取 XFF 倒数第 N 项：最近一层可信代理追加的是它实际看到的
# 对端地址，最左侧的项由客户端控制、可任意伪造。
# 设为 0 则忽略 XFF（x-real-ip 仍生效）；XFF 项数不足 N 或所选项无法
# 解析为 IP 时，回退到 x-real-ip / 直连地址。
trusted_proxy_hops = 1

[auth]
# 控制 /v1/* 代理接口的 API Key 认证开关。
# /api/* 的管理接口由外部反向代理（如 Authelia）鉴权，与此开关无关。
enabled = true


[database]
path = "./data/ait.db"

[log]
path = "./data/ait-logs.duckdb"
# 日志保留天数（默认 30 天），过期的日志会自动清理
retention_days = 30
# 日志刷盘间隔（秒）
flush_interval_secs = 10
# 批量刷盘阈值
flush_batch = 100
# 通道缓冲区大小，满时丢弃日志
channel_cap = 10000
# 每 flush_batch * retention_every 次写入后执行一次过期清理
retention_every = 100
# Analytics 查询超时（秒）
analytics_timeout_secs = 10

# 日志级别（trace / debug / info / warn / error）
level = "info"
# axum 框架日志级别
axum = "info"
# TraceLayer 每次请求的响应日志级别
tower_http_trace = "info"

[proxy]
# 代理请求超时时间
timeout_secs = 300
# 连接上游超时时间（秒）
connect_timeout_secs = 30
# SSE 空闲超时时间（秒）：上游静默超过该时长后断开流
sse_idle_timeout_secs = 60
# 流式响应总时长上限（秒）：防止上游每隔一段时间发送一个字节
# 无限维持连接；0 表示不限制
sse_max_duration_secs = 1800
# 是否支持流失传输
stream = true
# 响应体大小上限（字节），超出直接返回 400
max_response_body_bytes = 8388608
# 请求体大小上限（字节），超出直接返回 400
max_request_body_bytes = 8388608
# prompt token 估算除数（1-5）：上游未返回用量（连接中断等场景）时，
# 估算 prompt tokens = 请求体字节数 / 该值。
# 请求体含 JSON 结构与字段名，默认 3 偏向高估；可按实际用量调整以减小误差
prompt_token_divisor = 3

[security]
# 允许的跨域来源域名，空列表则拒绝所有跨域请求（同源部署不需要配置）
cors_allowed_origins = []
# 是否允许跨域请求携带凭证（外部反向代理鉴权场景）。
# 跨域部署（前端与后端不同域名）时设为 true。
# 注意：cors_allowed_origins 含 "*" 时与凭证互斥，两者同时配置会拒绝启动
cors_allow_credentials = false
# SSRF 白名单 CIDR（空列表则阻断所有私有 IP 出站请求）
# 例如 ssrf_allowed_cidrs = ["127.0.0.1/32", "::1/128"] 允许本机 Ollama/LocalAI
# 支持单 IP（自动 /32 或 /128）和 CIDR 段
ssrf_allowed_cidrs = []

# 请求体敏感信息检测（DLP）
[security.dlp]
# 是否启用 DLP 检测
enabled = false
# 命中即阻断的敏感值字面量列表（子串匹配、区分大小写）
# 例如 sensitive_values = ["110101199001011234", "13800138000", "sk-xxxxxxxxxx"]
sensitive_values = []
# 是否同时检测 JSON number 字面量（默认只检测字符串值）。
# 仅对纯数字的敏感值有意义：如 {"user_id": 13800138000} 中的数字。
# 开启后每个 number 字段都会额外参与匹配，略有开销。
scan_numbers = false
